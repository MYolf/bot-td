# Copier ce fichier en .env puis remplir les valeurs

# --- Discord ---
DISCORD_TOKEN=ton_token_de_bot_discord
DISCORD_CHANNEL_ID=id_du_salon_ou_publier_les_signaux

# --- Serveur webhook TradingView ---
PORT=3000
# Secret partagé : doit correspondre à celui configuré dans l'alerte TradingView
WEBHOOK_SECRET=change-moi-un-secret-long-et-aleatoire

# --- Divers ---
# Optionnel : autoriser seulement les requêtes venant de TradingView
# TRADINGVIEW_IP_ALLOWLIST=
