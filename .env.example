# Copier ce fichier en .env puis remplir les valeurs.
# Le fichier .env ne doit JAMAIS être commité dans Git.

# --- Application ---
APP_ENV=development

# --- Discord (Developer Portal : https://discord.com/developers/applications) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Salon où publier les signaux (mode développeur Discord -> clic droit sur le salon -> Copier l'identifiant)
DISCORD_SIGNALS_CHANNEL_ID=
# Salon optionnel pour les logs techniques
DISCORD_LOGS_CHANNEL_ID=
# Salon du suivi des trades : clôtures TP/SL en direct + récap hebdomadaire
DISCORD_RECAP_CHANNEL_ID=

# --- Récap hebdomadaire du paper trading ---
# Jour d'envoi (lundi=0 ... dimanche=6 ; 4 = vendredi), heure locale du fuseau
# RECAP_TIMEZONE. Les positions en cours restent affichées chaque semaine
# jusqu'à leur TP/SL.
# RECAP_ENABLED=true
# RECAP_WEEKDAY=4
# RECAP_HOUR=22
# RECAP_TIMEZONE=Europe/Paris

# --- Webhook TradingView ---
# Secret partagé : doit correspondre exactement à celui mis dans le message JSON de l'alerte TradingView.
# Long et aléatoire (ex: 32+ caractères). Ne jamais le logger ni le retourner dans une erreur.
TRADINGVIEW_WEBHOOK_SECRET=

# --- Base de données PostgreSQL ---
# Format local : postgresql+psycopg://bot_td:MotDePasseFort@localhost:5432/bot_td
DATABASE_URL=

# Identifiants PostgreSQL en production (docker-compose.prod.yml uniquement).
# POSTGRES_PASSWORD doit être long et aléatoire ; il n'est utilisé que pour
# créer/accéder à la base sur le VPS.
# POSTGRES_USER=bot_td
POSTGRES_PASSWORD=
# POSTGRES_DB=bot_td

# --- HTTPS production (Phase 17) ---
# Sous-domaine DuckDNS pointant vers le VPS (ex: bot-td.duckdns.org).
# Caddy obtient et renouvelle le certificat Let's Encrypt automatiquement.
DOMAIN=
# Token du compte DuckDNS (https://www.duckdns.org, login GitHub/Google) ;
# c'est aussi lui qui met à jour l'IP du sous-domaine.
DUCKDNS_TOKEN=

# --- Moteur de signaux local (conteneur "engine") ---
# Alternative gratuite à TradingView : bougies Binance (données publiques
# uniquement) -> Momentum V1 à la clôture -> POST vers le webhook du backend.
# ENGINE_WEBHOOK_URL est surchargé par docker-compose (réseau interne) ;
# cette valeur ne sert qu'en local hors Docker.
# ENGINE_ENABLED=true
# ENGINE_SYMBOLS=["BTCUSDT","ETHUSDT"]
# ENGINE_TIMEFRAME=15
# ENGINE_POLL_SECONDS=45
# ENGINE_CANDLE_LIMIT=500
ENGINE_WEBHOOK_URL=http://localhost:8000/webhook/tradingview
# Chaque bougie fermée est aussi POSTée ici (paper trading : clôture TP/SL
# sans attendre le signal suivant). Vide = désactivé.
ENGINE_PRICE_URL=http://localhost:8000/internal/prices

# --- Logs ---
LOG_LEVEL=INFO

# --- Listes blanches (JSON, optionnel — ces valeurs par défaut s'appliquent sinon) ---
# ALLOWED_SYMBOLS=["BTCUSDT","ETHUSDT","XAUUSD"]
# ALLOWED_TIMEFRAMES=["5","15","30","60","240","D"]
# ALLOWED_STRATEGIES=["momentum_v1","momentum_mtf_v1","trend_following_v2","gold_breakout_v1"]
# ALLOWED_EXCHANGES=["BINANCE","OANDA","FXCM"]

# Âge maximum d'un signal (secondes) avant rejet pour obsolescence
# SIGNAL_MAX_AGE_SECONDS=300
